{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org.calcium-denoiser-audit.metric-contract",
  "title": "MetricContract 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_id",
    "domain",
    "evidence_boundaries",
    "output_classes",
    "requires_clean_reference",
    "version"
  ],
  "properties": {
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "evidence_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "clean_reference",
          "pseudo_reference",
          "reference_free",
          "trace_event_truth",
          "locked_historical_final_test"
        ]
      }
    },
    "output_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "full_movie",
          "component_reconstruction",
          "trace_only"
        ]
      }
    },
    "requires_clean_reference": {
      "type": "boolean"
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requires_clean_reference": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "evidence_boundaries": {
            "const": [
              "clean_reference"
            ]
          }
        }
      }
    }
  ]
}
